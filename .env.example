# ===== 站点 =====
PORT=3000
SITE_NAME=vodhub
SITE_ANNOUNCEMENT=
SITE_ANNOUNCEMENT_TITLE=

# ===== 认证 =====
# 管理员密码：可访问 /sources 管理全站默认视频源
ADMIN_PASSWORD=change-me
# 访客/朋友密码（可选）：仅前端临时开关视频源，所有偏好与历史保存在各自浏览器
# ACCESS_PASSWORD=friend-pass
AUTH_SECRET=change-me-to-a-long-random-string
# AUTH_TOKEN_TTL=604800

# ===== 数据目录（存放 sources.json）=====
DATA_DIR=./data

# ===== 采集与网络 =====
# SEARCH_CONCURRENCY=5
# SEARCH_TIMEOUT_SECONDS=15
# 可选：支持 http:// https:// socks5:// socks5h://，仅对勾选 useProxy 的源生效，绝不代理视频播放
# UPSTREAM_PROXY=
# IMAGE_PROXY_ALLOWED_HOSTS=

# ===== 首次启动可选初始化视频源 =====
# SOURCES_URL=https://example.com/sources.json
# SOURCES_JSON=[]
